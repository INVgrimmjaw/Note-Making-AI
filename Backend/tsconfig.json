{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"]
  },

  "include": [
    "src/**/*.ts",
    "src/generated/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}